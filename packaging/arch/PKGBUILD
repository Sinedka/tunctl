pkgname=vpnctl
pkgver=0.1.0
pkgrel=1
pkgdesc='Terminal OpenVPN manager with systemd, nftables and application routing'
arch=('x86_64' 'aarch64')
url='https://github.com/sinedka/tunctl'
license=('GPL-3.0-only')
depends=('gcc-libs' 'openssl' 'ncurses' 'systemd' 'openvpn>=2.6' 'nftables>=1.0.7'
         'iproute2' 'iputils' 'bind' 'curl>=8.9' 'python' 'python-dnspython' 'glibc')
optdepends=('dnsmasq: local DNS-based routing')
makedepends=('cmake' 'nlohmann-json')
# Local source snapshot produced from the checkout, see docs/linux.md.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
