[Unit]
Description=VPNCTL connection guard
Requires=vpnctl-routing.service
After=vpnctl-routing.service
ConditionPathExists=|/var/lib/vpnctl/active.ovpn
ConditionPathExists=|/run/vpnctl/pending.ovpn

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/vpnctl-network guard
ExecStop=nft destroy table inet vpnctl_session
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
